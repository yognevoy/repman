{% extends 'base.html.twig' %}

{% block header %}
    <a href="{{ path('organization_packages', {"organization":organization.alias}) }}"
       class="btn btn-secondary px-1 mr-1" title="Package List">
        <span class="text-muted mr-1">&laquo;</span>
        {% include 'svg/package.svg' %}
    </a>

    {{ package.name }} edit
{% endblock %}
{% block header_btn %}
    {% include 'component/packageActions.html.twig' %}
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-6 col-lg-4">
            {{ form_start(form) }}
            {{ form_widget(form) }}
            {{ form_end(form) }}
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const lockField = document.querySelector('select[name="locked"]');
            const versionGroup = document.querySelector('#lockedVersion').closest('.form-group');
            const untilGroup = document.querySelector('#lockedUntil').closest('.form-group');

            function toggleLockFields() {
                if (lockField.value === '1') {
                    versionGroup.style.display = 'block';
                    untilGroup.style.display = 'block';
                } else {
                    versionGroup.style.display = 'none';
                    untilGroup.style.display = 'none';
                }
            }

            toggleLockFields();
            lockField.addEventListener('change', toggleLockFields);

            if (window.Litepicker) {
                new Litepicker({
                    element: document.getElementById('lockedUntil'),
                    format: 'DD.MM.YYYY',
                    buttonText: {
                        previousMonth: `{% include "svg/chevron-left.svg" %}`,
                        nextMonth: `{% include "svg/chevron-right.svg" %}`,
                    },
                });
            }
        });
    </script>
{% endblock %}
